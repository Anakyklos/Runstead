# Store-open failure paths close the just-created database before
# returning the failure that caused the open to abort; the close error is
# secondary to the error being returned.
internal/state/store.go:155  db.Close()
internal/state/store.go:159  db.Close()
internal/state/store.go:163  db.Close()
internal/state/store.go:167  db.Close()

# File and temp-file close on read/write paths is best-effort cleanup: the
# primary error of the operation is already checked and returned. The
# hasher.Write result cannot fail for the concrete hash implementations
# used here and is ignored by convention.
internal/tools/read_file.go:62  defer file.Close()
internal/tools/read_file.go:79  hasher.Write(chunk)
internal/tools/search_text.go:293  defer file.Close()
internal/tools/write.go:184  defer file.Close()
internal/tools/write.go:272  tmp.Close()
internal/tools/write.go:276  tmp.Close()
internal/tools/write.go:282  tmp.Close()
internal/tools/write_file.go:316  defer file.Close()
