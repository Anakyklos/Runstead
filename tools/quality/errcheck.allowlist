internal/state/approval_flow.go:100  defer rows.Close()
internal/state/events.go:43  defer rows.Close()
internal/state/governor_state.go:191  defer rows.Close()
internal/state/governor_state.go:210  defer rows.Close()
internal/state/governor_state.go:229  defer rows.Close()
internal/state/governor_state.go:248  defer rows.Close()
internal/state/governor_state.go:267  defer rows.Close()
internal/state/inspect.go:523  defer rows.Close()
internal/state/inspect.go:542  defer rows.Close()
internal/state/inspect.go:565  defer rows.Close()
internal/state/inspect.go:592  defer rows.Close()
internal/state/inspect.go:652  defer rows.Close()
internal/state/inspect.go:724  defer rows.Close()
internal/state/inspect.go:742  defer rows.Close()
internal/state/recovery.go:498  defer rows.Close()
